# Copiar este archivo como .env y completar los valores
PORT=4000
CLIENT_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_contraseña_de_root
DB_NAME=portfolio_db

# Texto largo y aleatorio (se usa para firmar los tokens de sesión)
JWT_SECRET=cambia_esto_por_un_texto_largo_y_aleatorio
JWT_EXPIRES_IN=7d

# --- Correo (tanda 2) ---
# Si EMAIL_USER y EMAIL_PASS quedan vacíos, el servidor funciona en MODO PRUEBA:
# los emails se muestran en la consola y no se envían.
# Para Gmail: cuenta con verificación en dos pasos + "contraseña de aplicación" (16 letras, sin espacios).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
MAIL_FROM="NombreTech <tu-cuenta@gmail.com>"
# Dónde te llegan los avisos de consultas nuevas (si queda vacío se usa EMAIL_USER)
OWNER_EMAIL=

# Consultas que una misma IP puede enviar cada 15 minutos
CONTACT_RATE_MAX=5
