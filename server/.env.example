# Copiar este archivo como .env y completar los valores
PORT=4000
# Uno o varios sitios autorizados a usar la API, separados por coma y sin "/" al final.
# En producción agregá la dirección de Vercel: http://localhost:5173,https://tu-sitio.vercel.app
CLIENT_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_contraseña_de_root
DB_NAME=portfolio_db
# Bases en la nube (TiDB Cloud, etc.): poner DB_SSL=true. Los otros dos son opcionales.
DB_SSL=false
DB_SSL_CA=
DB_SSL_REJECT_UNAUTHORIZED=true

# Texto largo y aleatorio (se usa para firmar los tokens de sesión)
JWT_SECRET=cambia_esto_por_un_texto_largo_y_aleatorio
JWT_EXPIRES_IN=7d

# --- Correo ---
# Sin ninguna de estas variables funciona en MODO PRUEBA: los emails solo se muestran en la consola.
# Opción A (tu computadora): SMTP de Gmail con contraseña de aplicación (16 letras, sin espacios).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
# Opción B (hostings que bloquean SMTP, como Render gratis): clave de API de Brevo. Tiene prioridad sobre la A.
BREVO_API_KEY=
# Remitente. Con Brevo tiene que ser un remitente verificado en tu cuenta de Brevo.
MAIL_FROM="NombreTech <tu-cuenta@gmail.com>"
# Dónde te llegan los avisos de consultas nuevas (si queda vacío se usa EMAIL_USER)
OWNER_EMAIL=

# Consultas que una misma IP puede enviar cada 15 minutos
CONTACT_RATE_MAX=5
