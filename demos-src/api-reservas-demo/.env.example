# Copiá este archivo como .env y ajustá los valores.
PORT=3000

# Conexión a MySQL (estos valores coinciden con docker-compose.yml)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=reservas
DB_NAME=reservas

# true: crea la tabla "reservas" al arrancar si no existe
DB_INIT=true

# Orígenes permitidos para llamar a la API desde un navegador (separados por coma, o *)
CORS_ORIGIN=*

# Zona horaria de la agenda: define qué es "hoy" y "ahora" al validar los turnos
AGENDA_TZ=America/Argentina/Buenos_Aires
